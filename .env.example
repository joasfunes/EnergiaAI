# EnergiaAI - configuración de referencia (sin secretos)
# Estos valores NO se cargan automáticamente desde este archivo.
# Opcional: establecerlos como variables de entorno de PowerShell antes de iniciar.
ENERGIAAI_LLM_MODEL=qwen3.5:9b
ENERGIAAI_OLLAMA_URL=http://127.0.0.1:11434
# Ollama requiere que también esté descargado embeddinggemma:300m para RAG.
# No agregar credenciales reales ni información de los hogares a este archivo.
